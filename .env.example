# Uygulama
HOST=0.0.0.0
PORT=3000
APP_BASE_PATH=/trafik
DEMO_MODE=false
CACHE_TTL_SECONDS=60
GA_CONCURRENCY=4
ALLOWED_ORIGIN=

# Docker host yayini
# Nginx ayni sunucudaysa 127.0.0.1, farkli sunucudaysa guvenlik duvari
# kisitlamasiyla 0.0.0.0 kullanin.
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=5000
DATA_DIR=./data
SITES_FILE=./data/sites.json

# Panel girisi
PANEL_USERNAME=farktor
PANEL_PASSWORD=BURAYA_GUCLU_BIR_PAROLA_YAZIN

# Google service account JSON dosyasindaki alanlar
GOOGLE_PROJECT_ID=google-cloud-proje-id
GOOGLE_CLIENT_EMAIL=service-account@proje-id.iam.gserviceaccount.com

# JSON icindeki private_key degerinin Base64 karsiligi
GOOGLE_PRIVATE_KEY_BASE64=BASE64_PRIVATE_KEY
